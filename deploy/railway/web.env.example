# Templates only. Enter values in Railway Variables, never in Git/chat.
NODE_ENV=production
APP_ENV=staging
HOSTNAME=0.0.0.0
PORT=3000
APP_URL=https://STAGING_DOMAIN
# Limited NOBYPASSRLS role in a SEPARATE staging database.
DATABASE_URL=
SESSION_SECRET=
DOCUMENT_ENCRYPTION_KEY=
STORAGE_DIR=/app/storage
DOCUMENT_SCAN_MODE=required
CLAMAV_HOST=clamav.railway.internal
CLAMAV_PORT=3310
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama.railway.internal:11434
OLLAMA_MODEL=qwen3:8b
AI_EXTERNAL_TRANSFER_APPROVED=false
AI_MAX_PARALLEL=1
AI_CONTEXT_TOKENS=16384
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=180000
AI_QUEUE_TIMEOUT_MS=10000
AI_DAILY_TOKEN_BUDGET=2000000
AI_COMPANY_DAILY_TOKEN_BUDGET=500000
EMAIL_PROVIDER=resend
EMAIL_FROM=
EMAIL_DOMAIN_VERIFIED=false
RESEND_API_KEY=
