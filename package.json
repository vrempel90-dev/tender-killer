{
  "name": "tender-killer",
  "version": "0.1.0",
  "private": true,
  "description": "AI-платформа анализа тендеров Казахстана: экономика сделки, проверка документов, риски договора",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "postbuild": "node scripts/copy-static.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "dotenv": "^18.0.8",
    "exceljs": "4.4.0",
    "jose": "6.2.12",
    "lucide-react": "1.57.0",
    "mammoth": "1.13.0",
    "next": "16.4.1",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@next/eslint-plugin-next": "^16.4.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
