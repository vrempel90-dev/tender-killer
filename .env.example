# ───────────────────────────────────────────────────────────────────
#  TENDER KILLER — пример переменных окружения.
#  Скопируйте в .env и подставьте свои значения. .env в Git не попадает.
# ───────────────────────────────────────────────────────────────────

# PostgreSQL не публикуется Compose. Задайте собственный пароль.
POSTGRES_PASSWORD=""
DATABASE_URL=""

# Роль приложения с минимальными правами (см. docs/db-isolation.md).
# Приложение в production подключается под ней: политики Row Level
# Security применяются к ней, а DDL ей недоступен. Миграции и сиды
# выполняются под владельцем схемы из DATABASE_URL.
# Создание роли: psql ... -f scripts/db-roles.sql
APP_DB_USER="tk_app_runtime"
APP_DB_PASSWORD=""
# Строка подключения этой роли. Нужна тесту изоляции tests/rls.spec.ts.
APP_DATABASE_URL=""

# Ключ шифрования загруженных документов: 32 байта в base64.
# Без него загрузка документов в production отключена — иначе файлы легли
# бы на диск в открытом виде. Сгенерировать: npm run keygen:documents
# Потеря ключа означает потерю доступа к уже загруженным документам.
DOCUMENT_ENCRYPTION_KEY=""

# Резервное копирование (docs/backup-restore.md).
# Парольная фраза копий: минимум 20 символов. Хранить ОТДЕЛЬНО от
# DOCUMENT_ENCRYPTION_KEY и отдельно от самих копий.
BACKUP_ENCRYPTION_PASSPHRASE=""
# Куда складывать копии (по умолчанию ./backups) и сколько хранить.
BACKUP_DIR="./backups"
BACKUP_KEEP="14"
# База для учебного восстановления (npm run backup:verify). ЕЁ СОДЕРЖИМОЕ
# БУДЕТ ЗАТЁРТО, поэтому она не должна совпадать с рабочей.
VERIFY_DATABASE_URL=""

# Отдельная БД для автотестов, которые работают с Prisma (необязательно:
# финансовые и парсерные тесты БД не требуют).
TEST_DATABASE_URL=""

# Секрет для подписи сессионных JWT. Минимум 32 символа.
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET="СМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_МИНИМУМ_32_СИМВОЛА"

# Локальный AI по умолчанию. Модели НЕ загружаются при сборке/старте.
AI_PROVIDER="ollama"
# Для npm run dev на хосте. Docker использует фиксированный http://ollama:11434.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"
# Сервер Ollama (Compose). Для CPU/других GPU можно выбрать f16 и attention=0.
OLLAMA_FLASH_ATTENTION="1"
OLLAMA_KV_CACHE_TYPE="q8_0"
OLLAMA_MEMORY_LIMIT="16g"
AI_TIMEOUT_MS="180000"
AI_QUEUE_TIMEOUT_MS="10000"
AI_MAX_PARALLEL="1"
AI_CONTEXT_TOKENS="16384"
AI_MAX_OUTPUT_TOKENS="2048"
AI_CHUNK_CHARS="2500"
AI_MAX_DOCUMENT_CHARS="250000"
AI_MAX_CHUNKS="40"
AI_DAILY_CALL_LIMIT="100"
AI_DAILY_TOKEN_BUDGET="2000000"
AI_COMPANY_DAILY_TOKEN_BUDGET="500000"
# Платный AI: только явный AI_PROVIDER=anthropic и разрешение владельца.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
AI_EXTERNAL_TRANSFER_APPROVED="false"

# Каталог хранения загруженных документов (вне репозитория).
STORAGE_DIR="../tender-killer-storage"
DOCUMENT_SCAN_MODE="required"
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# Максимальный размер загружаемого файла, байт (по умолчанию 25 МБ)
MAX_UPLOAD_BYTES="26214400"

# Точный origin браузера; обязателен для production и защиты mutation-запросов.
APP_URL="http://localhost:3000"
